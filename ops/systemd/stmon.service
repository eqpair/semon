[Unit]
Description=Stmon Telegram Monitor
After=network.target
PartOf=semon.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stmon
ExecStart=/home/ubuntu/stmon/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=semon.target
